%% Six to nine clusters: three environments x (two zonal stateless clusters + an optional stateful cluster),
%% plus one platform Key Vault per environment that holds that environment's certificates.
%% Every environment is built from the same IaC modules and the same Flux configuration, only parameters differ.
flowchart TB
    src["Same source for every environment<br/>IaC modules (Bicep / Terraform): one per cluster type, env + AZ as parameters<br/>Fleet Git repository: Flux configuration of everything inside the clusters"]

    subgraph DEV["dev · subscription sub-aks-dev"]
        d1["aks-dev-sl-az1<br/>stateless · AZ 1"]
        d2["aks-dev-sl-az2<br/>stateless · AZ 2"]
        d3["aks-dev-sf<br/>optional – built with the first<br/>approved exception<br/>stateful · AZ 1-3 · LTS"]
        kd["kv-dev-platform<br/>platform Key Vault<br/>dev certificates (own renewal job)<br/>*.&lt;zone&gt;.dev.example.com"]
        d1 ~~~ d2 ~~~ d3 ~~~ kd
    end
    subgraph ACC["acc · subscription sub-aks-acc"]
        a1["aks-acc-sl-az1<br/>stateless · AZ 1"]
        a2["aks-acc-sl-az2<br/>stateless · AZ 2"]
        a3["aks-acc-sf<br/>optional – built with the first<br/>approved exception<br/>stateful · AZ 1-3 · LTS"]
        ka["kv-acc-platform<br/>platform Key Vault<br/>acc certificates (own renewal job)<br/>*.&lt;zone&gt;.acc.example.com"]
        a1 ~~~ a2 ~~~ a3 ~~~ ka
    end
    subgraph PRD["prd · subscription sub-aks-prd"]
        p1["aks-prd-sl-az1<br/>stateless · AZ 1"]
        p2["aks-prd-sl-az2<br/>stateless · AZ 2"]
        p4["aks-prd-sl-az3<br/>optional 3rd AZ"]
        p3["aks-prd-sf<br/>optional – built with the first<br/>approved exception<br/>stateful · AZ 1-3 · LTS"]
        kp["kv-prd-platform<br/>platform Key Vault<br/>prd certificates (own renewal job)<br/>*.&lt;zone&gt;.prd.example.com"]
        p1 ~~~ p2 ~~~ p4 ~~~ p3 ~~~ kp
    end

    src -.->|"build (IaC) + deploy<br/>(Flux: stateless · pipeline: stateful)"| DEV
    DEV ==>|"promote: automated tests passed<br/>(same image digests, same Flux artifact)"| ACC
    ACC ==>|"promote: acceptance passed<br/>+ change approval"| PRD

    classDef sl fill:#e0f2f1,stroke:#00695c,color:#000
    classDef sf fill:#fce4ec,stroke:#ad1457,color:#000,stroke-dasharray: 5 5
    classDef opt fill:#f5f5f5,stroke:#9e9e9e,color:#000,stroke-dasharray: 5 5
    classDef paas fill:#eceff1,stroke:#455a64,color:#000
    classDef note fill:#fffde7,stroke:#9e9d24,color:#000
    class d1,d2,a1,a2,p1,p2 sl
    class d3,a3,p3 sf
    class p4 opt
    class kd,ka,kp paas
    class src note
