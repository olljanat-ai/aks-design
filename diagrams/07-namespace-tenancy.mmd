%% Application multi-tenancy inside one zone of a stateless cluster: namespace per application, default-deny
%% network policies, Traefik as the zone's Gateway API implementation (HTTPS only).
flowchart LR
    client(("Clients<br/>(Internet for ext-*,<br/>corporate for int-*)"))

    subgraph ZONE["Zone ext-fi (node pool extfi)"]
        direction LR
        appgw["App Gateway WAF v2<br/>HTTPS listener only"]
        subgraph ING["ns: ext-fi-ingress (platform)"]
            ic["Traefik · Gateway ext-fi<br/>listener HTTPS :443 only<br/>*.ext-fi.&lt;env&gt;.apps.example.com<br/>(Let's Encrypt)"]
        end
        subgraph A["ns: ext-fi-app-a"]
            ra["HTTPRoute app-a"]
            a1["frontend"] --> a2["backend"]
        end
        subgraph B["ns: ext-fi-app-b"]
            rb["HTTPRoute app-b"]
            b1["api"]
        end
    end

    subgraph SYS["kube-system"]
        dns["CoreDNS"]
    end

    http["Plain HTTP :80"]:::off

    client -->|"HTTPS"| appgw -->|"HTTPS (re-encrypt)"| ic
    ic -->|"HTTP, allowed by policy"| a1
    ic -->|"HTTP, allowed by policy"| b1
    a1 & a2 & b1 -->|"DNS allowed"| dns
    a2 -.-x|"default deny"| b1
    b1 -.-x|"default deny"| a1
    http -.-x|"no entry point, no LB port"| ic
    ra -.->|"attaches"| ic
    rb -.->|"attaches"| ic

    linkStyle 8,9,10 stroke:#c62828,stroke-width:2px,stroke-dasharray:5 5

    classDef ext fill:#fff3e0,stroke:#ef6c00,color:#000
    classDef cp fill:#eceff1,stroke:#455a64,color:#000
    classDef off fill:#ffebee,stroke:#c62828,color:#000,stroke-dasharray: 5 5
    class appgw,ic,a1,a2,b1,ra,rb ext
    class dns cp
