%% Encryption in transit. Stateless: TLS ends at the zone's Traefik gateway (Let's Encrypt certificate for an internal
%% name), node-to-node traffic is protected by Azure VNet encryption, so apps need no TLS, mTLS or service mesh.
%% Stateful: no ingress at all, the application terminates TLS on its own internal load balancer.
%% Certificates are issued once per zone and environment by a job per environment into the environment's single platform
%% Key Vault and shared by all clusters of that environment.
flowchart LR
    client(("Client"))

    subgraph MGMT["Management network"]
        job["Certificate renewal job of &lt;env&gt;<br/>(managed identity, Officer roles<br/>on kv-&lt;env&gt;-platform only)<br/>DNS-01 · renew 30 days before expiry"]
    end
    le["Let's Encrypt<br/>ACME"]
    pubdns["Public Azure DNS validation zone<br/>_acme-challenge TXT only"]
    kv["Platform Key Vault kv-&lt;env&gt;-platform<br/>(once per environment)<br/>cert-ext-fi-wildcard<br/>*.ext-fi.&lt;env&gt;.example.com<br/>+ cert-int-fi-…, cert-*-se-…"]

    subgraph EDGE["Traffic layer"]
        agw["App Gateway / Front Door<br/>HTTPS listener only"]
    end

    subgraph SL["Stateless clusters sl-az1/2/3 · Azure CNI Overlay · VNet encryption between nodes"]
        direction TB
        tr["Traefik Gateway (zone ext-fi)<br/>websecure :443 only<br/>HSTS · no :80<br/>cert synced by Secrets Store CSI"]
        subgraph N1["node A"]
            app1["app-a pod<br/>plain HTTP"]
        end
        subgraph N2["node B"]
            app2["app-a pod<br/>plain HTTP"]
        end
    end

    subgraph SF["Stateful cluster · Azure CNI (VNet) · no ingress / Gateway API"]
        direction TB
        ilb["Internal LB Service<br/>snet-ext-fi-ilb"]
        db["app-x pod<br/>terminates TLS itself<br/>same zone cert as PEM files (CSI)"]
    end

    paas["Azure PaaS<br/>private endpoint<br/>TLS enforced"]
    plain["Plain HTTP"]:::off

    client -->|"HTTPS"| agw
    agw -->|"HTTPS, backend cert validated<br/>(publicly trusted)"| tr
    tr -->|"HTTP inside the node"| app1
    tr -->|"HTTP, encrypted on the wire<br/>by VNet encryption"| app2
    app1 & app2 -->|"TLS via Firewall"| ilb --> db
    app1 & app2 -->|"TLS via Firewall"| paas
    job -->|"order / renew"| le
    job -->|"TXT record"| pubdns
    job -->|"import certificate"| kv
    kv -.->|"workload identity,<br/>RBAC on this certificate only"| tr
    kv -.->|"workload identity,<br/>RBAC on this certificate only"| db
    plain -.-x|"rejected: no listener, no LB port,<br/>Azure Policy denies HTTP listeners"| tr

    linkStyle 14 stroke:#c62828,stroke-width:2px,stroke-dasharray:5 5

    classDef hub fill:#ede7f6,stroke:#5e35b1,color:#000
    classDef sl fill:#e0f2f1,stroke:#00695c,color:#000
    classDef sf fill:#fce4ec,stroke:#ad1457,color:#000
    classDef paas fill:#eceff1,stroke:#455a64,color:#000
    classDef off fill:#ffebee,stroke:#c62828,color:#000,stroke-dasharray: 5 5
    class agw,job hub
    class tr,app1,app2 sl
    class ilb,db sf
    class paas,le,pubdns,kv paas
