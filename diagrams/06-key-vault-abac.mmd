%% Workload identity first: applications authenticate to Azure services with Entra ID (no keys, local auth disabled).
%% Key Vault holds secrets only for targets without Entra ID, separated per application with RBAC + ABAC conditions.
flowchart LR
    subgraph ZONE["Zone int-fi (namespaces on node pool intfi)"]
        direction TB
        subgraph NSA["ns: int-fi-app-a (no secrets)"]
            saA["ServiceAccount app-a<br/>azure.workload.identity/client-id"]
        end
        subgraph NSB["ns: int-fi-app-b (secret exception)"]
            saB["ServiceAccount app-b<br/>azure.workload.identity/client-id"]
            csiB["Secrets Store CSI<br/>mounted as files only"]
        end
    end

    subgraph ENTRA["Microsoft Entra ID"]
        miA["Managed identity id-int-fi-app-a<br/>federated credential per cluster:<br/>sl-az1, sl-az2, sf issuers<br/>subject system:serviceaccount:int-fi-app-a:app-a"]
        miB["Managed identity id-int-fi-app-b<br/>federated credential per cluster<br/>(secret exception for one partner API)"]
    end

    subgraph PAAS["Zone int-fi Azure services (local auth disabled)"]
        direction TB
        sql["Azure SQL<br/>Entra-only auth"]
        sb["Service Bus<br/>disableLocalAuth"]
        st["Storage<br/>shared key disabled"]
    end

    subgraph KV["Key Vault kv-&lt;env&gt;-int-fi (RBAC mode, private endpoint only, shared by all clusters of the environment)"]
        direction TB
        sB1["app-b-partner-api-key"]
        sX["app-c-…"]
        cert["cert-int-fi-wildcard<br/>(certificate, shared part)"]
    end

    tr["Traefik int-fi / stateful apps<br/>identities that need a certificate"]
    raC["Key Vault Secrets User @ kv-&lt;env&gt;-int-fi<br/>condition: secret name StringStartsWith 'cert-'"]

    ext["Third-party API<br/>(no Entra ID support)"]

    raB["Key Vault Secrets User @ kv-&lt;env&gt;-int-fi<br/>condition: secret name StringStartsWith 'app-b-'"]

    saA -->|"projected token → Entra token"| miA
    miA -->|"contained db user"| sql
    miA -->|"Data Sender / Receiver"| sb
    miA -->|"Blob Data Reader"| st
    csiB --> saB -->|"projected token → Entra token"| miB
    miB -->|"data-plane roles"| sql
    miB --> raB -->|"allow"| sB1
    raB -.-x|"ForbiddenByRbac"| sX
    csiB -.->|"app-b calls with the key"| ext

    other["Other zones' identities<br/>(no role assignment in zone int-fi)"] -.-x|"denied"| PAAS
    tr --> raC -->|"allow"| cert
    linkStyle 9,11 stroke:#c62828,stroke-width:2px,stroke-dasharray:5 5

    classDef int fill:#e3f2fd,stroke:#1565c0,color:#000
    classDef id fill:#e8f5e9,stroke:#2e7d32,color:#000
    classDef note fill:#fffde7,stroke:#9e9d24,color:#000
    classDef paas fill:#eceff1,stroke:#455a64,color:#000
    classDef off fill:#ffebee,stroke:#c62828,color:#000
    class saA,saB,csiB,sB1,sX int
    class miA,miB id
    class raB,raC note
    class cert int
    class tr id
    class sql,sb,st,ext paas
    class other off
